# DO NOT COMMIT REAL SECRETS TO GITHUB.
# Put these values in Railway Variables instead.

API_ID=23712517
API_HASH=334d992b622e393e838a7c21a1aded67

# REQUIRED: create/get this from @BotFather
BOT_TOKEN=

# Existing Telegram channel to scan
TARGET_CHANNEL=-1003097416646

# Backward-compatible alias (optional; TARGET_CHANNEL takes priority)
CHANNEL=-1003097416646

# Telegram numeric user ID allowed to use admin commands
OWNER_USER_ID=8741623856
ADMIN_IDS=8741623856

# Railway persistent volume path for SQLite
DB_PATH=/app/data/classes.db

# Optional settings
SESSION_NAME=bot
PAGE_SIZE=8

# MongoDB URI is NOT used by this SQLite version.
# If you later want MongoDB support, add it separately as MONGO_URI.
# MONGO_URI=
